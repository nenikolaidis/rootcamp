# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# The Firebase web config is public by design (security comes from firestore.rules), but keep
# real values in .env.local, which is git-ignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# true = use the local emulators (npm run emulators) under the demo-rootcamp project.
VITE_USE_EMULATORS=true
