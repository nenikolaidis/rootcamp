rules_version = '2';

// RootCamp Firestore rules. No server code: every guarantee lives here.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Limits (mirror src/game/limits.ts; tests/game/limits.test.ts keeps them in sync) ──
    function demoMaxXp() { return 5000; }
    function maxMissionReward() { return 600; }
    function weeklyXpCap() { return 20000; }

    // ── Helpers ──
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function stampedNow() { return incoming().updatedAt == request.time; }

    // XP may only grow, by one max reward plus one more per minute since the last write.
    // A player syncing after a long offline session is never refused; a script can't leap ahead.
    function xpGrowthOk() {
      let gain = incoming().xp - resource.data.xp;
      let minutes = (request.time - resource.data.updatedAt).seconds() / 60;
      return gain >= 0 && gain <= maxMissionReward() * (1 + minutes);
    }

    // ── Player profile ──
    function validProfile() {
      let d = incoming();
      return d.keys().hasOnly(['displayName', 'avatarSeed', 'title', 'settings', 'ageConfirmed', 'createdAt'])
        && d.keys().hasAll(['displayName', 'ageConfirmed', 'createdAt'])
        && isText(d.displayName, 1, 40)
        && isText(d.get('avatarSeed', ''), 0, 64)
        && isText(d.get('title', ''), 0, 40)
        && d.get('settings', {}) is map
        && d.ageConfirmed == true; // accounts are 15+
    }

    // ── Progress (users/{uid}/progress/main) ──
    function validProgress() {
      let d = incoming();
      return d.keys().hasOnly(['xp', 'rank', 'done', 'hints', 'quiz', 'achievements', 'codex', 'unlocks', 'schemaVersion', 'updatedAt'])
        && d.keys().hasAll(['xp', 'schemaVersion', 'updatedAt'])
        && d.xp is int && d.xp >= 0
        && d.schemaVersion is int
        && isText(d.get('rank', 'intern'), 1, 32)
        && d.get('done', {}) is map
        && d.get('hints', {}) is map
        && d.get('quiz', {}) is map
        && d.get('achievements', []) is list
        && d.get('codex', []) is list
        && d.get('unlocks', []) is list
        && stampedNow();
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile() && incoming().createdAt == request.time;
      allow update: if isOwner(uid) && validProfile() && incoming().createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);

      match /progress/{doc} {
        allow read: if isOwner(uid);
        // First write: guest (demo) progress moves into the new account.
        allow create: if isOwner(uid) && doc == 'main' && validProgress() && incoming().xp <= demoMaxXp();
        allow update: if isOwner(uid) && validProgress() && xpGrowthOk();
        allow delete: if isOwner(uid);
      }
    }

    // ── Weekly leaderboards ("for fun": client-written, bounded by these rules) ──
    function validWeek(weekId) { return weekId.matches('^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$'); }
    function validScore() {
      let d = incoming();
      return d.keys().hasOnly(['name', 'xp', 'rank', 'updatedAt'])
        && d.keys().hasAll(['name', 'xp', 'updatedAt'])
        && isText(d.name, 1, 40)
        && d.xp is int && d.xp >= 0 && d.xp <= weeklyXpCap()
        && isText(d.get('rank', 'intern'), 1, 32)
        && stampedNow();
    }

    match /leaderboards/{weekId}/scores/{uid} {
      allow read: if validWeek(weekId);
      allow create: if isOwner(uid) && validWeek(weekId) && validScore();
      allow update: if isOwner(uid) && validWeek(weekId) && validScore() && xpGrowthOk();
      allow delete: if isOwner(uid);
    }

    // ── Shared Builder blueprints ──
    function validBlueprint() {
      let d = incoming();
      return d.keys().hasOnly(['ownerUid', 'title', 'world', 'json', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'title', 'world', 'json', 'createdAt', 'updatedAt'])
        && isText(d.title, 1, 80)
        && d.world is string && d.world.matches('^w[0-9]{2}$')
        && isText(d.json, 2, 50000)
        && stampedNow();
    }

    match /blueprints/{id} {
      allow read: if true;
      allow create: if signedIn() && validBlueprint()
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && validBlueprint()
        && incoming().ownerUid == resource.data.ownerUid
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // One like per player: likes/{uid}. Count them with an aggregate query.
      match /likes/{uid} {
        allow read: if true;
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/blueprints/$(id))
          && incoming().keys().hasOnly(['createdAt'])
          && incoming().createdAt == request.time;
        allow delete: if isOwner(uid);
      }
    }
  }
}
